# Relative paths resolve against backend/
DATABASE_URL=sqlite:///./dataorigin.db
STORAGE_DIR=../storage
MAX_UPLOAD_MB=20
CHAIN_ENABLED=true
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_DEPLOYMENT_FILE=app/chain_deployment.json
DEMO_MODE=true
CORS_ORIGINS=http://localhost:8000
FRONTEND_DIR=../frontend

# --- Public network (e.g. Sepolia), Leave empty for the local Hardhat setup. ---
# CHAIN_RPC_URL above becomes your provider URL, e.g. https://eth-sepolia.g.alchemy.com/v2/<api-key>
CHAIN_CONTRACT_ADDRESS=
# Private key of a wallet used ONLY for this app, holding only test ETH. Never commit a real value.
CHAIN_PRIVATE_KEY=
CHAIN_START_BLOCK=0
CHAIN_RECEIPT_TIMEOUT=120
